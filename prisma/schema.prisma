generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  DOWNLOADING
  AVAILABLE
}

enum EntityKind {
  LEAGUE
  TEAM
  EVENT
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  passwordHash       String
  role               Role                @default(USER)
  active             Boolean             @default(true)
  locale             String              @default("en")
  timezone           String              @default("UTC")
  autoApprove        Boolean?
  // New requests a user may start in any rolling seven days; null means no limit.
  weeklyRequestLimit Int?
  // The account stops working at this moment; null means it never expires.
  expiresAt          DateTime?
  // What the user may request; without a plan, everything.
  planId             String?
  plan               Plan?               @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdAt          DateTime            @default(now())
  sessions           Session[]
  subscriptions      RequestSubscriber[]
  issues             Issue[]             @relation("IssueReporter")
  issueComments      IssueComment[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model CatalogEntity {
  id          String               @id @default(uuid())
  kind        EntityKind
  title       String
  metadata    Json
  updatedAt   DateTime             @updatedAt
  identifiers ExternalIdentifier[]
  requests    Request[]
  bindings    ManagerBinding[]
}

model ExternalIdentifier {
  id        String        @id @default(uuid())
  entityId  String
  entity    CatalogEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  provider  String
  namespace String
  value     String

  @@unique([provider, namespace, value])
  @@index([entityId])
}

model Request {
  id               String              @id @default(uuid())
  entityId         String
  entity           CatalogEntity       @relation(fields: [entityId], references: [id])
  scopeKey         String
  scope            Json
  status           RequestStatus       @default(PENDING)
  integrationState String              @default("idle")
  lastError        String?
  reviewedBy       String?
  rejectionReason  String?
  version          Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  subscribers      RequestSubscriber[]
  history          RequestHistory[]
  events           RequestEvent[]
  // Requested event parts (e.g. Main Card). None means the whole event, as before parts existed.
  parts            RequestPart[]
  issues           Issue[]
  // Season scope has ended and every event is final; per-user availability needs it.
  closed           Boolean             @default(false)

  @@unique([entityId, scopeKey])
  @@index([status, updatedAt])
}

model RequestSubscriber {
  requestId         String
  userId            String
  request           Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Parts this user asked for; empty means every part of the request.
  parts             String[]      @default([])
  // This user's view of the request, derived from their parts.
  status            RequestStatus @default(PENDING)
  // This user started the request, so it uses one of their weekly requests. Following an
  // existing request never does, and a rejected one gives it back.
  countsTowardQuota Boolean       @default(false)
  createdAt         DateTime      @default(now())

  @@id([requestId, userId])
  @@index([userId, createdAt])
}

model RequestHistory {
  id        String   @id @default(uuid())
  requestId String
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId   String?
  action    String
  details   Json
  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
}

model ManagerBinding {
  id        String        @id @default(uuid())
  entityId  String
  entity    CatalogEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  manager   String
  remoteId  String
  snapshot  Json
  checkedAt DateTime      @updatedAt

  @@unique([manager, entityId])
  @@unique([manager, remoteId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model OutboxEvent {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  processedAt DateTime?
  jobId       String?

  @@index([publishedAt, createdAt])
  @@index([processedAt, publishedAt])
}

model NotificationDelivery {
  id        String   @id @default(uuid())
  eventId   String
  channel   String
  recipient String
  status    String   @default("pending")
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())

  @@unique([eventId, channel, recipient])
}

model RequestEvent {
  id               String    @id @default(uuid())
  requestId        String
  request          Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  externalId       String
  metadata         Json
  remoteId         Int?
  active           Boolean   @default(true)
  available        Boolean   @default(false)
  progress         Float     @default(0)
  checkedAt        DateTime?
  // Parts Sportarr defines for this event; empty when it is a single file.
  parts            String[]  @default([])
  availableParts   String[]  @default([])
  downloadingParts String[]  @default([])
  downloading      Boolean   @default(false)
  issues           Issue[]

  @@unique([requestId, externalId])
}

/// One requested part of an event or season request. Its review state is shared by
/// every subscriber who asked for it.
model RequestPart {
  id              String        @id @default(uuid())
  requestId       String
  request         Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  name            String
  status          RequestStatus @default(PENDING)
  reviewedBy      String?
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([requestId, name])
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IssueCategory {
  WRONG_CONTENT
  MISSING_CONTENT
  QUALITY
  LANGUAGE
  PLAYBACK
  OTHER
}

/// A problem a subscriber reports about requested content. Only the reporter and
/// administrators can see it.
model Issue {
  id             String         @id @default(uuid())
  requestId      String
  request        Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  reporterId     String
  reporter       User           @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  // The affected event of a season request, and the affected part when the event has parts.
  requestEventId String?
  requestEvent   RequestEvent?  @relation(fields: [requestEventId], references: [id], onDelete: SetNull)
  part           String?
  category       IssueCategory
  status         IssueStatus    @default(OPEN)
  description    String
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  comments       IssueComment[]

  @@index([reporterId, status, updatedAt])
  @@index([status, updatedAt])
  @@index([requestId])
}

/// A comment, a status change, or both, in an issue's timeline.
model IssueComment {
  id        String       @id @default(uuid())
  issueId   String
  issue     Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String?
  status    IssueStatus?
  createdAt DateTime     @default(now())

  @@index([issueId, createdAt])
}

enum PlanGrantKind {
  SPORT
  LEAGUE
}

/// A content package: which sports and leagues users on the plan may request.
model Plan {
  id         String      @id @default(uuid())
  name       String      @unique
  // Every sport and league, whatever the grants say.
  allContent Boolean     @default(false)
  grants     PlanGrant[]
  users      User[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

/// One sport or league a plan includes, by its Sportarr Hub ID.
model PlanGrant {
  id     String        @id @default(uuid())
  planId String
  plan   Plan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  kind   PlanGrantKind
  hubId  String
  // Hub's name when the grant was added, for display.
  name   String

  @@unique([planId, kind, hubId])
}
