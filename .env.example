# Generate a long URL-safe password; do not commit .env.
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
APP_PORT=3000
LOG_LEVEL=info
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters

# Behind a reverse proxy, trust its X-Forwarded-For so rate limits apply per
# client: a hop count (1) or the proxy addresses/CIDR (e.g. 172.18.0.0/16).
# Leave empty when Pedirr is reached directly. "true" is rejected.
TRUST_PROXY=

# Conservative shared outbound metadata budget, not an upstream quota guarantee.
HUB_REQUESTS_PER_MINUTE=20

# Minutes before repeating an automatic search that found nothing (15-10080).
SEARCH_RETRY_MINUTES=60

# Generate with: openssl rand -hex 32. Back up separately from the database.
SETTINGS_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters
