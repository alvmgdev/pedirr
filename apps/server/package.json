{
  "name": "@pedirr/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "dev": "node --watch --require ts-node/register src/main.ts",
    "dev:worker": "node --watch --require ts-node/register src/worker.ts",
    "test": "node --test test/*.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.19.0",
    "argon2": "^0.45.1",
    "bullmq": "^5.63.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "nodemailer": "^10.3.1",
    "pino": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
